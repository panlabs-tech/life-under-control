{
  "mcpServers": {
    "hostinger-vps": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "hostinger-api-mcp@0.2.5",
        "hostinger-vps-mcp"
      ],
      "env": {}
    },
    "coolify": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@masonator/coolify-mcp@2.12.0"
      ],
      "env": {
        "COOLIFY_BASE_URL": "https://vps.panlabs.tech",
        "COOLIFY_ACCESS_TOKEN": "${COOLIFY_ACCESS_TOKEN}"
      }
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "meta-devtools": {
      "type": "http",
      "url": "https://mcp.facebook.com/devtools"
    },
    "aws": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@1.4.0"
      ],
      "env": {
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
